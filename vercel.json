{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/sluzby", "destination": "/#sluzby", "permanent": true },
    { "source": "/cenik", "destination": "/#cenik", "permanent": true },
    { "source": "/recenze", "destination": "/#recenze", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(fonts|img|video)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ]
}
